# ==========================================
# CapitalAI Backend Environment Variables
# Copy to .env for local development
# Render automatically supplies PORT in production
# ==========================================

# Port binding (Render injects $PORT automatically)
PORT=8000

# Allowed CORS Origins (comma-separated). Note: *.vercel.app is allowed automatically via regex
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://capitalai.vercel.app
