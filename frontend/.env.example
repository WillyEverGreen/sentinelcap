# ==========================================
# CapitalAI Frontend Environment Variables
# Copy to .env.local for local development
# Add these in Vercel Project Settings -> Environment Variables
# ==========================================

# Backend API Endpoint (Render deployment URL in production)
# Example production: https://capitalai-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Canonical Application Domain
NEXT_PUBLIC_APP_URL=https://capitalai.vercel.app

# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk Routing Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Groq LPU Inference API Key (for Sentinel Copilot AI Advisor)
GROQ_API_KEY=gsk_...
